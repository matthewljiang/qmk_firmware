// CM(name, output, keys...) -- one line per combo. Consumed by X-macro
// expansion in keymap.c (once to build the PROGMEM key arrays, once to build
// key_combos[]). Keys are Colemak positions, so combos fire on the base layer.

// Utility -- bottom-row pairs (flexion, easier on the extensors than top-row)
CM(combo_bspc, KC_BSPC, KC_H, KC_COMM)
CM(combo_ent,  KC_ENT,  KC_COMM, KC_DOT)
CM(combo_tab,  KC_TAB,  KC_X, KC_C)

// Layer launcher: all four left home keys -> one-shot FN
CM(combo_fn,   OSL(_FN), KC_A, KC_R, KC_S, KC_T)

// Numbers -- vertical pairs (top row over home row): 1-5 left, 6-0 right
CM(combo_1, KC_1, KC_Q, KC_A)
CM(combo_2, KC_2, KC_W, KC_R)
CM(combo_3, KC_3, KC_F, KC_S)
CM(combo_4, KC_4, KC_P, KC_T)
CM(combo_5, KC_5, KC_B, KC_G)
CM(combo_6, KC_6, KC_J, KC_M)
CM(combo_7, KC_7, KC_L, KC_N)
CM(combo_8, KC_8, KC_U, KC_E)
CM(combo_9, KC_9, KC_Y, KC_I)
CM(combo_0, KC_0, KC_SCLN, KC_O)

// Brackets -- horizontal top-row pairs. Open < { [ ( on left, close ) ] } > on right.
CM(combo_labk, KC_LABK, KC_Q, KC_W)
CM(combo_lcbr, KC_LCBR, KC_W, KC_F)
CM(combo_lbrc, KC_LBRC, KC_F, KC_P)
CM(combo_lprn, KC_LPRN, KC_P, KC_B)
CM(combo_rprn, KC_RPRN, KC_J, KC_L)
CM(combo_rbrc, KC_RBRC, KC_L, KC_U)
CM(combo_rcbr, KC_RCBR, KC_U, KC_Y)
CM(combo_rabk, KC_RABK, KC_Y, KC_SCLN)

// Symbols -- home-row pairs (Shift gives ~ | on grave/backslash)
CM(combo_grv,  KC_GRV,  KC_A, KC_R)
CM(combo_plus, KC_PLUS, KC_G, KC_M)
CM(combo_mins, KC_MINS, KC_N, KC_E)
CM(combo_eql,  KC_EQL,  KC_E, KC_I)
CM(combo_bsls, KC_BSLS, KC_I, KC_O)
